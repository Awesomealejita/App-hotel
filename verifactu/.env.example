PORT=3000
DB_PATH=data/verifactu.db
# Token para dar de alta clientes de la API (POST /admin/clientes)
ADMIN_TOKEN=cambia-esto

# AEAT: "pruebas" (preproducción) o "produccion"
AEAT_ENTORNO=pruebas
# false = genera registros pero no los envía (desarrollo)
AEAT_ENVIO_ACTIVO=false
# Certificado electrónico en PKCS#12 (.p12/.pfx) del obligado o del representante/colaborador social
AEAT_CERT_PATH=./certs/certificado.p12
AEAT_CERT_PASSWORD=
# true si el certificado es de sello de entidad (usa el endpoint www10/prewww10)
AEAT_CERT_SELLO=false
WORKER_INTERVALO_MS=5000

# Datos del sistema informático (productor del software, el que firma la declaración responsable)
SIF_NOMBRE_RAZON=MI EMPRESA SL
SIF_NIF=B00000000
SIF_NOMBRE=VerifactuAPI
SIF_ID=VA
SIF_VERSION=0.1.0
SIF_NUMERO_INSTALACION=1
